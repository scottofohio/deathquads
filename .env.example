# Printful private API token (Settings → API → API access in the Developer Portal, or your store's API settings)
# Read-only scopes needed: "View store products" + "View store files"
PRINTFUL_API_KEY=your_printful_api_key

# Snipcart public API key (Test mode: https://app.snipcart.com/dashboard/account/credentials)
GATSBY_SNIPCART_API_KEY=your_snipcart_public_api_key
